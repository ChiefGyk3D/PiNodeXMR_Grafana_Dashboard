# Grafana datasource provisioning for the PiNodeXMR dashboard.
#
# THIS is the "database" the dashboard reads from: a Prometheus-compatible
# datasource with the fixed UID `pinodexmr-prometheus`. The dashboard JSON
# references that UID directly, which is why it loads with no manual
# datasource picking.
#
# The URL may be the locally managed Prometheus or any existing
# Prometheus-API-compatible database (Prometheus, Mimir, VictoriaMetrics,
# Thanos Query) elsewhere in your lab.
#
# Generated by the installer. Grafana reloads provisioning on restart.

apiVersion: 1

datasources:
  - name: @@DS_NAME@@
    uid: pinodexmr-prometheus
    type: prometheus
    access: proxy
    url: @@PROM_URL@@
    isDefault: true
    editable: false
@@DS_AUTH_BLOCK@@
    jsonData:
      httpMethod: POST
      timeInterval: @@SCRAPE_INTERVAL@@
      manageAlerts: false
@@DS_JSON_EXTRA@@
