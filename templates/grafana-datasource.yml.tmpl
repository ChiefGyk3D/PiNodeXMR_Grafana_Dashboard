# Grafana datasource provisioning for the PiNodeXMR dashboard.
#
# THIS is the "database" the dashboard reads from: a Prometheus datasource
# with the fixed UID `pinodexmr-prometheus`. The dashboard JSON references
# that UID directly, which is why it loads with no manual datasource picking.
#
# Generated by the installer. Grafana reloads provisioning on restart.

apiVersion: 1

datasources:
  - name: @@DS_NAME@@
    uid: pinodexmr-prometheus
    type: prometheus
    access: proxy
    url: @@PROM_URL@@
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: @@SCRAPE_INTERVAL@@
      manageAlerts: false
