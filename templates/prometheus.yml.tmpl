# Prometheus configuration for a PiNodeXMR monitoring stack (local mode).
# Generated by the PiNodeXMR Grafana Dashboard installer — re-run install.sh
# to regenerate, or edit in place and `systemctl reload prometheus`.

global:
  scrape_interval: @@SCRAPE_INTERVAL@@
  evaluation_interval: @@SCRAPE_INTERVAL@@
  external_labels:
    monitor: pinodexmr

scrape_configs:
  # The PiNodeXMR device itself. monerod metrics arrive through
  # node_exporter's textfile collector, so this single job covers both the
  # host metrics and every monerod_* series the dashboard needs.
  - job_name: node
    static_configs:
      - targets: ['@@NODE_EXPORTER_TARGET@@']
        labels:
          instance_name: '@@INSTANCE_NAME@@'
          role: 'crypto-node'
    relabel_configs:
      # Present the device under a friendly name instead of host:port, which
      # is what the dashboard's `instance` dropdown lists.
      - source_labels: [__address__]
        target_label: instance
        replacement: '@@INSTANCE_NAME@@'

  # Prometheus' own metrics — useful for spotting scrape failures.
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:@@PROM_PORT@@']

