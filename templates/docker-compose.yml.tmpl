# PiNodeXMR monitoring stack (Docker flavour).
#
# Only Prometheus and Grafana are containerised. node_exporter and the monerod
# exporter stay on the host: node_exporter needs host /proc, /sys and the
# textfile collector directory that the monerod exporter writes to, and running
# it on the host keeps the metrics identical between the native and Docker
# flavours.
#
# Generated by the installer. Manage with:
#   cd @@DOCKER_DIR@@ && docker compose up -d

services:
  prometheus:
    image: @@PROM_IMAGE@@
    container_name: pinodexmr-prometheus
    restart: unless-stopped
    user: "@@PUID@@:@@PGID@@"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=@@RETENTION@@'
      - '--storage.tsdb.retention.size=@@RETENTION_SIZE@@'
      - '--web.enable-lifecycle'
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "@@PROM_BIND@@:@@PROM_PORT@@:9090"
    # Lets Prometheus reach the host's node_exporter as host.docker.internal
    # on Docker Engine 20.10+ without relying on the docker0 bridge address.
    extra_hosts:
      - "host.docker.internal:host-gateway"

  grafana:
    image: @@GRAFANA_IMAGE@@
    container_name: pinodexmr-grafana
    restart: unless-stopped
    user: "@@PUID@@:@@PGID@@"
    depends_on:
      - prometheus
    environment:
      GF_SECURITY_ADMIN_USER: "@@GRAFANA_ADMIN_USER@@"
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_SERVER_HTTP_PORT: "3000"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana
    secrets:
      - grafana_admin_password
    ports:
      - "@@GRAFANA_BIND@@:@@GRAFANA_PORT@@:3000"

secrets:
  grafana_admin_password:
    file: ./secrets/grafana_admin_password

volumes:
  prometheus-data:
  grafana-data:
