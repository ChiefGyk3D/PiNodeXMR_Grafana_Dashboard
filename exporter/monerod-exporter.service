[Unit]
Description=Monerod Prometheus Metrics Exporter
Documentation=https://github.com/ChiefGyk3D/PiNodeXMR_Grafana_Dashboard
After=network-online.target moneroStatus.service
Wants=network-online.target

[Service]
User=pinodexmr
Group=pinodexmr
Type=simple
ExecStart=/bin/bash /home/pinodexmr/monerod-exporter.sh
Restart=always
RestartSec=10
# Limit rapid restart loops: max 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node_exporter/textfile_collector
PrivateTmp=true

[Install]
WantedBy=multi-user.target
